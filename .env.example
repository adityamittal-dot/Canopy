# Copy to .env for local use, or set these as environment variables on
# whatever host you deploy to (e.g. Railway's project Variables tab).
# Nothing here is read from an actual .env file automatically unless
# your process manager loads one - manage.py/gunicorn just read os.environ.

# Required in production (DEBUG defaults to False without this).
SECRET_KEY=

# "True" locally, unset/"False" in production.
DJANGO_DEBUG=False

# Comma-separated. For Railway: your *.up.railway.app domain, or a custom
# domain once one is attached.
DJANGO_ALLOWED_HOSTS=your-app.up.railway.app

# Comma-separated, must include the scheme (https://). Needed once DEBUG
# is off and the app sits behind HTTPS, for Django's CSRF checks to trust
# the Origin header a browser sends.
CSRF_TRUSTED_ORIGINS=https://your-app.up.railway.app

# Provided automatically by Railway's Postgres plugin - takes priority
# over the DB_* vars below when set. Local docker-compose uses the DB_*
# vars instead since it doesn't set this.
DATABASE_URL=

# Only used as a fallback when DATABASE_URL isn't set (local docker-compose).
DB_NAME=canopy
DB_USER=canopy
DB_PASSWORD=canopy
DB_HOST=localhost
DB_PORT=5432

# Optional. Raises the request allowance against GitHub's raw-content host
# for the detail panel's source-snippet fetch. Needs no scopes for public
# repos.
GITHUB_TOKEN=
