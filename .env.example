# Copy to .env for local use, or set these as environment variables on
# whatever host you deploy to (e.g. Railway's project Variables tab).
# Nothing here is read from an actual .env file automatically unless
# your process manager loads one - manage.py/gunicorn just read os.environ.

# Required in production (DEBUG defaults to False without this).
SECRET_KEY=

# "True" locally, unset/"False" in production.
DJANGO_DEBUG=False

# Comma-separated. Your assigned domain - e.g. your-app.up.railway.app or
# your-app.onrender.com - or a custom domain once one is attached.
DJANGO_ALLOWED_HOSTS=your-app.onrender.com

# Optional, comma-separated, must include the scheme (https://). If unset,
# derived automatically from DJANGO_ALLOWED_HOSTS (same hosts, https://
# prefixed) - only set this explicitly if CSRF needs to trust an origin
# that isn't in ALLOWED_HOSTS.
CSRF_TRUSTED_ORIGINS=

# Provided automatically by Render's/Railway's Postgres plugin - takes
# priority over the DB_* vars below when set. Local docker-compose uses
# the DB_* vars instead since it doesn't set this.
DATABASE_URL=

# Only used as a fallback when DATABASE_URL isn't set (local docker-compose).
DB_NAME=canopy
DB_USER=canopy
DB_PASSWORD=canopy
DB_HOST=localhost
DB_PORT=5432

# Optional. Raises the request allowance against GitHub's raw-content host
# for the detail panel's source-snippet fetch. Needs no scopes for public
# repos.
GITHUB_TOKEN=
